# Copy to .env and fill in for server/secure-proxy.js.
# Never commit the real .env file — it's already in .gitignore.

# Partner API Key. Kept server-side only; the browser never sees this.
VE_PAK=

# Override for dev/local VideoEngager environments.
VE_API_BASE=https://videome.leadsecure.com

# Port for the local demo + proxy server.
PORT=8787
